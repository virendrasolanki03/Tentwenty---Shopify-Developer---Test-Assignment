{% comment %}
  TenTwenty Tilted Cards Drag Slider — Shopify Section (Pixel Perfect v3)
  ─────────────────────────────────────────────────────────────────────────
  Place this file in: sections/tentwenty-tilted-slider.liquid
  No external libraries required — pure CSS + Vanilla JS.

  v3.1: Side Card Rotation is now two independent, fully-signed controls
  (Left / Right) instead of one shared magnitude — either side can be
  set positive or negative on its own.
{% endcomment %}

{%- liquid
  assign sid       = 'tt-' | append: section.id
  assign card_half = section.settings.card_width | divided_by: 2
  assign side_half = section.settings.card_width | times: section.settings.side_scale | divided_by: 100 | divided_by: 2
  assign side_x    = card_half | plus: section.settings.gap | plus: side_half
-%}

<style>

  
/* ══════════════════════════════════════════════════════════════
   TenTwenty Tilted Slider  ·  #{{ sid }}
   ══════════════════════════════════════════════════════════════ */
#{{ sid }} {
  background: {{ section.settings.bg_color }};
  padding-top:    {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

/* ── Header ──────────────────────────────────────────────────── */
#{{ sid }} .tt-header {
  text-align: {{ section.settings.title_align }};
  padding: 0 28px;
  margin-bottom: {{ section.settings.header_gap }}px;
}
#{{ sid }} .tt-header-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}
#{{ sid }} .tt-heading {
  font-size: {{ section.settings.title_size }}px;
  font-weight: {{ section.settings.title_weight }};
  color: {{ section.settings.title_color }};
  margin:0px;
  margin-bottom: 16px;
  letter-spacing: 0px;
  line-height: 1.15;

}
#{{ sid }} .tt-body {
  font-size: {{ section.settings.body_size }}px;
  line-height: 1.72;
  color: {{ section.settings.body_color }};
  max-width: {{ section.settings.body_max_width }}px;
  margin: 0 auto;
   letter-spacing: 0px;
}

/* ── Slider wrapper — clips side-card bleed ──────────────────── */
#{{ sid }} .tt-slider {
  overflow: hidden;
}

/* ── Stage (drag surface) ────────────────────────────────────── */
#{{ sid }} .tt-stage {
  position: relative;
  width: 100%;
  height: {{ section.settings.stage_height }}px;
  cursor: grab;
  user-select: none;
  -webkit-user-select: none;
  touch-action: pan-y;
}
#{{ sid }} .tt-stage:active { cursor: grabbing; }

/* ── Cards ───────────────────────────────────────────────────── */
/*
 * All cards share the same anchor: dead-centre of the stage.
 * JS applies translateX / rotate / scale via inline style.
 * transform-origin: center → rotating a side card doesn't shift
 * its vertical position, so left/right cards stay level with the
 * upright centre card no matter how much they're tilted.
 */
#{{ sid }} .tt-card {
  position: absolute;
  left: 50%;
  top: 50%;
  width: {{ section.settings.card_width }}px;
  height: {{ section.settings.card_height }}px;
  margin-left: -{{ card_half }}px;
  margin-top: -{{ section.settings.card_height | divided_by: 2 }}px;

  border-radius: {{ section.settings.card_radius }}px;
  overflow: hidden;
  background: #d0c8be;

  transform-origin: center center;
  will-change: transform, opacity;

  {% if section.settings.card_shadow %}
  box-shadow: 0 18px 55px rgba(0,0,0,.17);
  {% endif %}

  transition:
    transform {{ section.settings.anim_duration }}ms cubic-bezier(0.77, 0, 0.175, 1),
    opacity   {{ section.settings.anim_duration }}ms cubic-bezier(0.77, 0, 0.175, 1);
}
#{{ sid }} .tt-card.no-tr {
  transition: none !important;
}
#{{ sid }} .tt-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  pointer-events: none;
  -webkit-user-drag: none;
  user-select: none;
}
#{{ sid }} .tt-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e0dbd3;
}
#{{ sid }} .tt-placeholder svg {
  width: 48px;
  height: 48px;
  opacity: .3;
}

/* ── Drag bubble ──────────────────────────────────────────────── */
#{{ sid }} .tt-drag-hint {
  position: absolute;
  left: 50%;
  top: 45%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 30;

  background: {{ section.settings.drag_bg }};
  color: {{ section.settings.drag_color }};
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.07em;
 text-transform: capitalize;
    padding: 40px 33px;
    border-radius: 100%;
  white-space: nowrap;
  box-shadow: 0 2px 14px rgba(0,0,0,.10);

  opacity: 0;
  transition: opacity 0.28s ease;
}
#{{ sid }} .tt-stage:hover     .tt-drag-hint { opacity: 1; }
#{{ sid }} .tt-stage.dragging  .tt-drag-hint { opacity: 0 !important; }

/* ── Client meta ──────────────────────────────────────────────── */
#{{ sid }} .tt-meta {
  text-align: center;
  padding: {{ section.settings.meta_gap }}px 24px 0;
  min-height: 50px;
  opacity: 1;
  transform: translateY(0);
  transition:
    opacity   {{ section.settings.text_anim_duration }}ms ease,
    transform {{ section.settings.text_anim_duration }}ms ease;
}
#{{ sid }} .tt-meta.is-changing {
  opacity: 0;
  transform: translateY({{ section.settings.text_anim_distance }}px);
}
#{{ sid }} .tt-name {
  font-size: {{ section.settings.name_size }}px;
  font-weight: 400;
  color: {{ section.settings.name_color }};
  margin-bottom: 5px;
  letter-spacing:0;
}
#{{ sid }} .tt-loc {
  font-size: {{ section.settings.loc_size }}px;
  color: {{ section.settings.loc_color }};
}

/* ── Dots ─────────────────────────────────────────────────────── */
#{{ sid }} .tt-dots {
  display: flex;
  justify-content: center;
  gap: 6px;
  padding-top: {{ section.settings.dots_gap }}px;
}
#{{ sid }} .tt-dot {
  width: {{ section.settings.dot_size }}px;
  height: {{ section.settings.dot_size }}px;
  border-radius: 50%;
  background: {{ section.settings.dot_inactive }};
  border: none;
  cursor: pointer;
  padding: 0;
  transition: background .3s, transform .3s;
}
#{{ sid }} .tt-dot.on {
  background: {{ section.settings.dot_active }};
  transform: scale(1.45);
}

/* ── Responsive ───────────────────────────────────────────────── */
@media (max-width: 560px) {

  #{{ sid }} .tt-name {
   font-size:24px;
  }

   #{{ sid }} .tt-loc {
   font-size:16px; 
  }

#{{ sid }}{
  padding-top : 82px;
 }
 .tt-heading {
  font-size:30px!important;
}


 .tt-body{
  font-size:16px!important;
 }
  
  #{{ sid }} .tt-card {
    width:      232px;
    height:      331px;
    margin-left: -120px;
    margin-top:  -150px;
  }
  #{{ sid }} .tt-stage {
    height: 400px;
  }
}
</style>

<!-- ═══════════════════════════ HTML ════════════════════════════ -->
<div id="{{ sid }}">

  {%- if section.settings.title != blank or section.settings.body_text != blank -%}
  <div class="tt-header">
    <div class="tt-header-inner">
      {%- if section.settings.title != blank -%}
        <{{ section.settings.heading_tag }} class="tt-heading">
          {{ section.settings.title }}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}
      {%- if section.settings.body_text != blank -%}
        <p class="tt-body">{{ section.settings.body_text }}</p>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  <div class="tt-slider">
    <div class="tt-stage" id="{{ sid }}-stage">

      <div class="tt-drag-hint">{{ section.settings.drag_label }}</div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
        <div class="tt-card" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag: loading: 'lazy', alt: block.settings.name
            }}
          {%- else -%}
            <div class="tt-placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {%- endif -%}
        </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    {%- if section.settings.show_meta -%}
    <div class="tt-meta" id="{{ sid }}-meta">
      <div class="tt-name" id="{{ sid }}-name"></div>
      <div class="tt-loc"  id="{{ sid }}-loc"></div>
    </div>
    {%- endif -%}

    {%- if section.settings.show_dots -%}
    <div class="tt-dots" id="{{ sid }}-dots"></div>
    {%- endif -%}
  </div>

</div>
<!-- ════════════════════════════════════════════════════════════ -->

<script>
(function () {
  'use strict';

  /* ── DOM ─────────────────────────────────────────────────── */
  var stage    = document.getElementById('{{ sid }}-stage');
  var cards    = Array.from(stage.querySelectorAll('.tt-card'));
  var dotsWrap = document.getElementById('{{ sid }}-dots');
  var metaWrap = document.getElementById('{{ sid }}-meta');
  var metaName = document.getElementById('{{ sid }}-name');
  var metaLoc  = document.getElementById('{{ sid }}-loc');
  var total    = cards.length;
  var current  = 0;

  /* ── Slide data ──────────────────────────────────────────── */
  var SLIDES = [
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
      {
        name: {{ block.settings.name     | default: '' | json }},
        loc:  {{ block.settings.location | default: '' | json }}
      }{% unless forloop.last %},{% endunless %}
      {%- endif -%}
    {%- endfor -%}
  ];

  /* ── Layout constants (same math as the HTML demo) ───────── */
  /*
   *  SIDE_X = (card_half) + GAP + (card_half × side_scale)
   *
   *  This guarantees a visible GAP between the centre card's
   *  edge and the side card's edge — matching the reference.
   */
  var CARD_W   = {{ section.settings.card_width }};

  /* Independent, fully-signed rotation per side. Each can be set
     positive or negative on its own — there is no forced sign or
     inward-lean coupling between them. */
  var ROT_LEFT  = {{ section.settings.rotation_left }};
  var ROT_RIGHT = {{ section.settings.rotation_right }};

  var SIDE_SC  = {{ section.settings.side_scale | divided_by: 100.0 }};
  var GAP      = {{ section.settings.gap }};
debugger
  if(window.innerWidth <  480){
   var GAP  = 32;
  }

  var SIDE_X   = Math.round(CARD_W / 2 + GAP + (CARD_W * SIDE_SC) / 2);

  var FAR_SC   = {{ section.settings.far_scale | divided_by: 100.0 }};
  var FAR_X    = Math.round(SIDE_X + (CARD_W * SIDE_SC) / 2 + GAP + (CARD_W * FAR_SC) / 2);

  var THRESHOLD = {{ section.settings.drag_threshold }};
  var TEXT_ANIM_MS = {{ section.settings.text_anim_duration }};

  /* Vertical position of side cards, as a % from the top of the
     stage. The centre card always sits at 50% (dead centre); side
     cards ease toward this % as they move away from centre. */
  var CENTER_TOP_PCT = 50;
  var SIDE_TOP_PCT   = {{ section.settings.side_vertical_position }};

  /* ── Drag state ──────────────────────────────────────────── */
  var isDragging = false;
  var startX     = 0;
  var dragX      = 0;

  /* ── Build dots ──────────────────────────────────────────── */
  if (dotsWrap) {
    SLIDES.forEach(function (_, i) {
      var d = document.createElement('button');
      d.className = 'tt-dot';
      d.setAttribute('aria-label', 'Slide ' + (i + 1));
      d.addEventListener('click', function () { goTo(i); });
      dotsWrap.appendChild(d);
    });
  }

  /* ── Transform calculator ────────────────────────────────── */
  /*
   * pos          = integer position relative to active (−2,−1,0,1,2…)
   * liveProgress = fractional drag in card-units (range: ±1 mid-drag)
   *
   * Rotation: left cards (p < 0) scale toward ROT_LEFT, right cards
   * (p > 0) scale toward ROT_RIGHT, each fully independent and
   * fully signed — set either to a negative value if you want that
   * side tilting the opposite way.
   */
  function getRotation(p, absP) {
    if (p === 0) return 0;
    if (p < 0) {
      return absP <= 1 ? absP * ROT_LEFT : ROT_LEFT;
    }
    return absP <= 1 ? absP * ROT_RIGHT : ROT_RIGHT;
  }

  function getStyle(pos, liveProgress, stageH) {
    var p    = pos + liveProgress;
    var absP = Math.abs(p);

    if (absP > 2.6) {
      return { tx: 0, ty: 0, rot: 0, scale: 0, opacity: 0, z: 0 };
    }

    /* Horizontal offset */
    var tx;
    if (absP <= 1) {
      tx = p * SIDE_X;
    } else {
      var over = absP - 1;
      tx = (p < 0 ? -1 : 1) * (SIDE_X + over * (FAR_X - SIDE_X));
    }

    /* Vertical offset — eases from the centre card's 50% down to
       SIDE_TOP_PCT as the card moves toward the side slot, then
       holds there for cards further out. */
    var t   = Math.min(absP, 1);
    var pct = CENTER_TOP_PCT + (SIDE_TOP_PCT - CENTER_TOP_PCT) * t;
    var ty  = (pct - CENTER_TOP_PCT) / 100 * stageH;

    /* Rotation — independent per side, see getRotation() above */
    var rot = getRotation(p, absP);

    /* Scale */
    var scale;
    if (absP <= 1) {
      scale = 1 - absP * (1 - SIDE_SC);
    } else {
      scale = SIDE_SC - (absP - 1) * (SIDE_SC - FAR_SC);
    }
    scale = Math.max(0.3, scale);

    /* Opacity */
    var opacity;
    if (absP <= 1.0) {
      opacity = 1;
    } else if (absP <= 2.0) {
      opacity = Math.max(0, 1 - (absP - 1));
    } else {
      opacity = 0;
    }

    /* Z-index */
    var z = Math.round(20 - absP * 6);

    return { tx: tx, ty: ty, rot: rot, scale: scale, opacity: opacity, z: z };
  }

  /* ── Apply transforms to all cards ──────────────────────── */
  function applyAll(liveProgress, noTr) {
    var stageH = stage.getBoundingClientRect().height;
    cards.forEach(function (card, i) {
      var pos = i - current;
      if (pos >  total / 2) pos -= total;
      if (pos < -total / 2) pos += total;

      var s = getStyle(pos, liveProgress, stageH);

      card.style.transform = [
        'translateX(' + s.tx.toFixed(2)    + 'px)',
        'translateY(' + s.ty.toFixed(2)    + 'px)',
        'rotate('     + s.rot.toFixed(2)   + 'deg)',
        'scale('      + s.scale.toFixed(3) + ')'
      ].join(' ');
      card.style.opacity = s.opacity.toFixed(3);
      card.style.zIndex  = s.z;
      card.classList.toggle('no-tr', noTr);
    });
  }

  /* ── Update meta & dots ──────────────────────────────────── */
  function updateUI(animate) {
    var s = SLIDES[current] || {};

    function setText() {
      if (metaName) metaName.textContent = s.name || '';
      if (metaLoc)  metaLoc.textContent  = s.loc  || '';
    }

    if (animate && metaWrap) {
      metaWrap.classList.add('is-changing');
      window.setTimeout(function () {
        setText();
        metaWrap.classList.remove('is-changing');
      }, TEXT_ANIM_MS);
    } else {
      setText();
    }

    if (dotsWrap) {
      Array.from(dotsWrap.querySelectorAll('.tt-dot')).forEach(function (d, i) {
        d.classList.toggle('on', i === current);
      });
    }
  }

  /* ── Navigate ────────────────────────────────────────────── */
  function goTo(idx) {
    var next = ((idx % total) + total) % total;
    var changed = next !== current;
    current = next;
    applyAll(0, false);
    updateUI(changed);
  }

  /* ── Mouse drag ──────────────────────────────────────────── */
  stage.addEventListener('mousedown', function (e) {
    e.preventDefault();
    isDragging = true;
    startX = e.clientX;
    dragX  = 0;
    stage.classList.add('dragging');
    cards.forEach(function (c) { c.classList.add('no-tr'); });
  });

  window.addEventListener('mousemove', function (e) {
    if (!isDragging) return;
    dragX = e.clientX - startX;
    applyAll(dragX / CARD_W, true);
  });

  window.addEventListener('mouseup', function () {
    if (!isDragging) return;
    isDragging = false;
    stage.classList.remove('dragging');
    cards.forEach(function (c) { c.classList.remove('no-tr'); });
    if (Math.abs(dragX) > THRESHOLD) {
      goTo(current + (dragX < 0 ? 1 : -1));
    } else {
      applyAll(0, false);
    }
    dragX = 0;
  });

  /* ── Touch drag ──────────────────────────────────────────── */
  stage.addEventListener('touchstart', function (e) {
    startX = e.touches[0].clientX;
    dragX  = 0;
    stage.classList.add('dragging');
    cards.forEach(function (c) { c.classList.add('no-tr'); });
  }, { passive: true });

  stage.addEventListener('touchmove', function (e) {
    dragX = e.touches[0].clientX - startX;
    applyAll(dragX / CARD_W, true);
  }, { passive: true });

  stage.addEventListener('touchend', function () {
    stage.classList.remove('dragging');
    cards.forEach(function (c) { c.classList.remove('no-tr'); });
    if (Math.abs(dragX) > THRESHOLD) {
      goTo(current + (dragX < 0 ? 1 : -1));
    } else {
      applyAll(0, false);
    }
    dragX = 0;
  });

  /* ── Keyboard ────────────────────────────────────────────── */
  stage.setAttribute('tabindex', '0');
  stage.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowLeft')  goTo(current - 1);
    if (e.key === 'ArrowRight') goTo(current + 1);
  });

  /* ── Auto-play ───────────────────────────────────────────── */
  {%- if section.settings.autoplay -%}
  var autoT = setInterval(function () { goTo(current + 1); }, {{ section.settings.autoplay_ms }});
  stage.addEventListener('mouseenter', function () { clearInterval(autoT); });
  stage.addEventListener('mouseleave', function () {
    autoT = setInterval(function () { goTo(current + 1); }, {{ section.settings.autoplay_ms }});
  });
  {%- endif -%}

  /* ── Init ────────────────────────────────────────────────── */
  goTo(0);

})();
</script>

{% schema %}
{
  "name": "TT Tilted Slider",
  "settings": [

    { "type": "header", "content": "━━ Content ━━" },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Quality Products"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "Alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "center"
    },

    { "type": "header", "content": "━━ Typography ━━" },
    {
      "type": "range",
      "id": "title_size",
      "label": "Heading Size (px)",
      "min": 18, "max": 80, "step": 1,
      "default": 30
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Heading Weight",
      "options": [
        { "value": "300", "label": "Light"    },
        { "value": "400", "label": "Regular"  },
        { "value": "500", "label": "Medium"   },
        { "value": "600", "label": "SemiBold" },
        { "value": "700", "label": "Bold"     }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body Text Size (px)",
      "min": 10, "max": 24, "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "body_max_width",
      "label": "Body Max Width (px)",
      "min": 200, "max": 800, "step": 10,
      "default": 380
    },

    { "type": "header", "content": "━━ Colors ━━" },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f4efe8"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#636363"
    },

    { "type": "header", "content": "━━ Card ━━" },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card Width (px)",
      "min": 120, "max": 480, "step": 5,
      "default": 220
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card Height (px)",
      "min": 150, "max": 650, "step": 10,
      "default": 290
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Corner Radius (px)",
      "min": 0, "max": 30, "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "card_shadow",
      "label": "Card Drop Shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "stage_height",
      "label": "Slider Stage Height (px)",
      "min": 160, "max": 800, "step": 10,
      "default": 370,
      "info": "Should match Card Height"
    },

    { "type": "header", "content": "━━ Animation & Spacing ━━" },
    {
      "type": "range",
      "id": "rotation_left",
      "label": "Side Card Rotation — Left (°)",
      "min": -60, "max": 60, "step": 5,
      "default": -10,
      "info": "Rotation of cards to the left of centre, set independently from the right. Negative values flip the tilt direction."
    },
    {
      "type": "range",
      "id": "rotation_right",
      "label": "Side Card Rotation — Right (°)",
      "min": -60, "max": 60, "step": 5,
      "default": 10,
      "info": "Rotation of cards to the right of centre, set independently from the left. Negative values flip the tilt direction."
    },
    {
      "type": "range",
      "id": "side_vertical_position",
      "label": "Side Card Vertical Position (% from top)",
      "min": 30, "max": 80, "step": 1,
      "default": 57,
      "info": "The centre card always sits at 50% (dead centre). Left/right cards ease toward this % as they move to the side."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Cards (px)",
      "min": 0, "max": 140, "step": 2,
      "default": 24,
      "info": "Visible background gap between the centre and side cards"
    },
    {
      "type": "range",
      "id": "side_scale",
